# Copy this file to .env for local development.
# Never commit real secrets.

# Environment mode: "development", "test", or "production"
# In "production" mode, startup validation enforces strong JWT_SECRET and non-default officer credentials.
ENVIRONMENT=development

# PostgreSQL (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg://civic:civic@localhost:5432/civic_dna

# JWT for officer authentication
# For production, supply a random secret of at least 32 characters (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Optional bootstrap officer created on API startup if the username does not exist
# In production, use a strong password or leave blank/unset to disable automatic bootstrapping.
OFFICER_BOOTSTRAP_USERNAME=officer
OFFICER_BOOTSTRAP_PASSWORD=changeme

# Configurable CORS allowed origins (comma-separated list)
# Default includes localhost Vite/React development ports.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Set true only for local experiments without running Alembic
CIVIC_CREATE_TABLES=false

# Deduplication and clustering configuration
DEDUP_THRESHOLD=0.65
DEDUP_GEO_RADIUS_METERS=300.0
DEDUP_TEMPORAL_WINDOW_HOURS=72.0
DEDUP_WEIGHT_TEXT=0.35
DEDUP_WEIGHT_GEO=0.30
DEDUP_WEIGHT_DEPT=0.15
DEDUP_WEIGHT_CATEGORY=0.10
DEDUP_WEIGHT_TEMPORAL=0.10

# Optional Neo4j graph storage
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# ML classification provider: "keyword" (default, offline) or "llm"
ML_PROVIDER=keyword

# Only required when ML_PROVIDER=llm
# ML_API_KEY=your-api-key-here
# ML_MODEL_NAME=your-model-name

# Confidence threshold for low-confidence / manual review (default 0.5)
# ML_CONFIDENCE_THRESHOLD=0.5
