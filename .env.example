# Copy this file to .env for local development.
# Never commit real secrets.

# PostgreSQL (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg://civic:civic@localhost:5432/civic_dna

# JWT for officer authentication — replace in every deployed environment
JWT_SECRET=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Optional bootstrap officer created on API startup if the username does not exist
OFFICER_BOOTSTRAP_USERNAME=officer
OFFICER_BOOTSTRAP_PASSWORD=changeme

# Set true only for local experiments without running Alembic
CIVIC_CREATE_TABLES=false
