# Copy this file to .env for local development.
# Never commit real secrets.

# PostgreSQL (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg://civic:civic@localhost:5432/civic_dna

# JWT for officer authentication — replace in every deployed environment
JWT_SECRET=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Optional bootstrap officer created on API startup if the username does not exist
OFFICER_BOOTSTRAP_USERNAME=officer
OFFICER_BOOTSTRAP_PASSWORD=changeme

# Set true only for local experiments without running Alembic
CIVIC_CREATE_TABLES=false

# Deduplication and clustering configuration
DEDUP_THRESHOLD=0.65
DEDUP_GEO_RADIUS_METERS=300.0
DEDUP_TEMPORAL_WINDOW_HOURS=72.0
DEDUP_WEIGHT_TEXT=0.35
DEDUP_WEIGHT_GEO=0.30
DEDUP_WEIGHT_DEPT=0.15
DEDUP_WEIGHT_CATEGORY=0.10
DEDUP_WEIGHT_TEMPORAL=0.10

# Optional Neo4j graph storage
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
